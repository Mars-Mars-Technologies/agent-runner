# --- hms-api -------------------------------------------------------------
# Base URL of the API including /api, and the shared secret (= AGENT_RUNNER_TOKEN in hms-api .env)
HMS_API_URL=https://hms-api.example.com/api
RUNNER_TOKEN=
# Unique per runner process; used to recover this runner's orphaned tasks after a restart
RUNNER_ID=runner-1
# Frontend base URL, used for the "view task" link in PR bodies
HMS_FE_URL=https://hms.example.com

# --- Claude ----------------------------------------------------------------
ANTHROPIC_API_KEY=
# Optional model override (empty = SDK default)
AGENT_MODEL=
MAX_TURNS=60
MAX_BUDGET_USD=3
TASK_TIMEOUT_MIN=30

# --- GitHub App (permissions: Contents read/write, Pull requests read/write; nothing else) ---
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_PATH=/etc/agent-runner/github-app.pem

# --- Git identity for every agent commit (author and committer) ------------
GIT_AUTHOR_NAME=HMS Agent
GIT_AUTHOR_EMAIL=marsandmarstechnologies@gmail.com

# --- Runner ---------------------------------------------------------------
MAX_CONCURRENT=1
POLL_INTERVAL_SEC=10
WORK_DIR=/var/lib/agent-runner/work
JOB_IMAGE=hms-agent-job:latest
# Per-container limits; defaults fit a 1 GB RAM + 4 GB swap server (raise on bigger hosts)
CONTAINER_MEMORY=900m
CONTAINER_MEMORY_SWAP=3g
CONTAINER_CPUS=1
