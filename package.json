{
  "name": "agent-runner",
  "version": "0.1.0",
  "private": true,
  "description": "Runs hms-api agent tasks in disposable Docker containers with the Claude Agent SDK and opens GitHub PRs.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node --env-file=.env dist/index.js",
    "build:image": "docker build -t hms-agent-job:latest -f job/Dockerfile job"
  },
  "dependencies": {
    "@octokit/auth-app": "8.3.1",
    "@octokit/rest": "22.0.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
